{
  "name": "snapme",
  "version": "0.1.0",
  "private": true,
  "description": "Browser photobooth: camera, poses, strip decoration, download or print. Gesture Snap, Strip Estafet, and Strip Hidup with QR.",
  "license": "MIT",
  "author": "Rori Setiawan <https://github.com/ikhsanddy>",
  "homepage": "https://github.com/ikhsanddy/snapme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikhsanddy/snapme.git"
  },
  "bugs": {
    "url": "https://github.com/ikhsanddy/snapme/issues"
  },
  "keywords": [
    "photobooth",
    "photo-strip",
    "nextjs",
    "cloudflare-workers",
    "mediapipe",
    "gesture-recognition",
    "konva",
    "webcam",
    "privacy-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/patch-opennext.mjs",
    "cf:patch": "node scripts/patch-opennext.mjs",
    "preview": "npm run cf:patch && opennextjs-cloudflare build && wrangler d1 migrations apply snapme-db --local && wrangler dev",
    "preview:e2e": "npm run cf:patch && opennextjs-cloudflare build && wrangler d1 migrations apply snapme-db --local && wrangler dev --env e2e",
    "deploy": "npm run cf:patch && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e:cf": "playwright test -c playwright.cf.config.ts",
    "perf:lcp": "lighthouse http://localhost:8787 --output=json --output-path=test-results/lighthouse-welcome.json --only-categories=performance --chrome-flags=\"--headless=new\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@phosphor-icons/react": "^2.1.10",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.4",
    "konva": "^10.8.0",
    "motion": "^14.2.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.0",
    "react-webcam": "^7.2.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
