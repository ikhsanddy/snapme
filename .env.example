# Salin ke `.env.local` lalu isi nilainya (ARCHITECTURE §8).
# Hanya URL Supabase yang boleh berawalan NEXT_PUBLIC_: nilainya memang
# dibaca browser untuk mengunggah langsung ke Storage lewat URL bertanda tangan.
NEXT_PUBLIC_SUPABASE_URL=
# Kunci service role TIDAK PERNAH dipakai di klien dan tidak boleh diberi
# awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Rahasia pembersih harian (Vercel Cron mengirim Authorization: Bearer).
CRON_SECRET=
# Garam untuk menyingkat sidang alamat IP pada pembatasan laju.
RATE_LIMIT_SALT=
