# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# local Cloudflare secrets (contoh ada di .dev.vars.example)
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare binding types: derived from wrangler.jsonc by `npm run cf-typegen`,
# which `postinstall` runs (docs/DECISIONS.md).
cloudflare-env.d.ts

# MediaPipe wasm: copied from the lockfile-pinned package by
# scripts/copy-mediapipe-wasm.mjs. The gesture model stays committed.
public/mediapipe/wasm/

# Next.js regenerates AGENTS.md locally when a coding agent is present, so it must never be committed.
/AGENTS.md

# Third-party style reference kept locally only: the webp is a collage of
# another product's screens as well as its brand and customers, so it is not
# redistributed with this repo (docs/ui-reference/README.md).
docs/ui-reference/referensi_uiux.webp

# /brag output: the plan, the Hyperframes composition, and the rendered video.
# Derived from the app and from the skill's own assets, and the video alone is
# megabytes, so it stays out of git like the other derived assets. `git add -f`
# if a run ever needs to be committed.
/brag-output*/
